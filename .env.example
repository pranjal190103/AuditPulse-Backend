# Configure these values in the deployment environment. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=auditpulseapi.vestaging.in
CORS_ALLOWED_ORIGINS=https://auditpulse.vestaging.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://auditpulseapi.vestaging.in
DJANGO_DATABASE_PATH=/app/data/db.sqlite3
DJANGO_MEDIA_ROOT=/app/data/media
# Absolute Chromium/Chrome executable path used for HTML-faithful PDF reports.
# Linux example: /usr/bin/chromium
AUDIT_REPORT_CHROMIUM_PATH=/usr/bin/chromium
